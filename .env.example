# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REQUIRE_AUTH=false

# Extraction & processing services
# Accounting worker (FastAPI on Render) that parses bank statements.
ACCOUNTING_WORKER_URL=
ACCOUNTING_WORKER_TOKEN=
# Conversion / OCR worker.
# CONVERSION_WORKER_URL is needed by the CALLER (Vercel / local dev) to reach the
# worker. It is NOT set on the worker itself: when CONVERSION_WORKER_MODE=true the
# OCR binaries are local, so extractWithOcr runs lib/pdf/ocrEngine in-process and
# never issues an HTTP request.
CONVERSION_WORKER_URL=
CONVERSION_WORKER_SECRET=
# pdfplumber extraction service (services/pdf-plumber). Point at its deployed URL
# (e.g. https://docucorex-pdf-plumber.onrender.com) or http://localhost:8001 in dev.
PDF_PLUMBER_URL=

# Secondary OCR engine (Mistral OCR). Escalation only: the OCRmyPDF/Tesseract
# conversion worker stays the primary engine, and Mistral is called only when OCR
# confidence is low, required fields are missing, reconciliation fails, or
# Enhanced OCR is explicitly requested. Leave blank to disable entirely.
#
# ⚠️ REQUIRED IN TWO RUNTIMES. The Mistral call is made from inside
# runExtractionPipeline, which executes on:
#   • Vercel                    — /api/ocr/:id, /api/pdf/analyze/:id, accounting
#                                 pre-extraction, accounting Enhanced-OCR retry
#   • Render conversion worker  — /api/jobs/process (Vercel proxies the whole job
#                                 to the worker, which runs the pipeline locally)
# Setting it only on Vercel silently disables the second engine for every generic
# document OCR/extraction job. Not needed on the Python accounting worker or the
# pdfplumber service — neither runs the Node pipeline.
MISTRAL_API_KEY=
# Optional overrides (defaults shown in comments).
# MISTRAL_OCR_MODEL=mistral-ocr-4-0
# MISTRAL_OCR_TIMEOUT_MS=120000
# MISTRAL_MIN_OCR_CONFIDENCE=70
# MISTRAL_MIN_SELECTION_CONFIDENCE=60

# Extraction strategy tuning.
# A "digital" PDF below this analysis confidence is treated as suspect and OCR is
# kept available alongside native extraction.
# NATIVE_MIN_CONFIDENCE=60
# Accounting: every statement is analysed by default. Set to "false" as an
# emergency bypass to skip the Node pipeline entirely.
# ACCOUNTING_PRE_EXTRACT=false
# Retry a statement with Enhanced OCR when the Python worker parses no
# transactions (default on).
# ACCOUNTING_OCR_FALLBACK=false

# Azure Document Intelligence (prebuilt-layout). A first-class extraction
# provider, used as an ESCALATION only: it runs after the acceptance gate has
# rejected the native result, ahead of Mistral, because prebuilt-layout returns
# real table structure. Never called for a healthy digital PDF.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Optional overrides (defaults shown).
# AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_MS=120000
# AZURE_DOCUMENT_INTELLIGENCE_POLL_MS=2000
# Selection-confidence floor below which a bank statement is escalated to Azure.
# Deliberately above the ~82% the integration targets.
# AZURE_MIN_SELECTION_CONFIDENCE=85

# Shadow mode (Phase C) — OBSERVATIONAL ONLY. When "true", every accepted bank
# statement is ALSO run through Azure after the workbook has been generated, and
# the two extractions are compared into extraction_shadow_comparisons. It never
# influences extraction, acceptance or the exported workbook. Costs one Azure
# call per statement, so leave it off until you are deliberately measuring.
# ACCOUNTING_SHADOW_AZURE=true

# AI & Processing Providers
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_FORM_RECOGNIZER_ENDPOINT=
AZURE_FORM_RECOGNIZER_KEY=
